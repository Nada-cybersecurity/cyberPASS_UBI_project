  "version": "0.1.0",
  "type": "module",
  "description": "Context-aware cybersecurity and compliance passport for Africa-Europe business (MVP).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
